# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Memory
# Hindsight needs an LLM provider to extract and process memories internally.
# Using Groq here (same key as above, different env var name required by Hindsight)
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=your_groq_api_key_here

# Hindsight configuration
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=incident-memory
